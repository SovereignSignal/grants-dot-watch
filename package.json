{
  "name": "grants-dot-watch",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "node --test --experimental-strip-types --experimental-loader ./tests/ts-loader.mjs tests/*.test.mjs",
    "test:browser": "playwright test",
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "validate": "node scripts/validate-registry.mjs && npm run validate:funding",
    "validate:funding": "node scripts/validate-registry-v2.mjs",
    "stage:funding": "node scripts/stage-funding-import.mjs",
    "audit:programs": "node scripts/audit-program-quality.mjs",
    "close:stale": "node scripts/close-stale-rounds.mjs",
    "audit:deps": "npm audit --omit=dev --audit-level=moderate",
    "check:loader": "node scripts/load-registry-pg.mjs --check-only",
    "typecheck": "tsc --noEmit",
    "check:public": "node scripts/check-public-boundary.mjs",
    "lint": "eslint . --max-warnings=0",
    "ci": "npm run check:public && npm run validate && npm run check:loader && npm run audit:deps && npm run lint && npm test && npm run typecheck && npm run build && npm run test:browser"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.2.8",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@privy-io/js-sdk-core": "^0.68.3",
    "@privy-io/node": "^0.9.0",
    "next": "^16.4.2",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^26.1.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "postcss": "^8.5.28",
    "railway": "3.12.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "^20.9.0 || >=22.0.0"
  },
  "overrides": {
    "axios": "1.18.1",
    "postcss": "$postcss",
    "sharp": "0.35.5",
    "viem": {
      "ws": "8.21.1"
    },
    "brace-expansion@1": "1.1.21",
    "brace-expansion@5": "5.0.12",
    "js-yaml": "4.3.2",
    "nanoid": "3.3.18"
  }
}
